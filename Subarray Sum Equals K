class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
    unordered_map<int,int>prefixSum;
    prefixSum[0]=1;
    int pf=0;
    int n=nums.size();
    int count=0;
    for(int i=0;i<n;i++) {
        pf+=nums[i];
        if(prefixSum.find(pf-k)!=prefixSum.end()) {
            count+=prefixSum[pf-k];
        } 
        prefixSum[pf]++;
    }
    return count;
    }
};
